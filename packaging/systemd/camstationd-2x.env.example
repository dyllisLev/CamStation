# Installation template only. Copy to /etc/camstation2/camstationd.env, set owner
# root:root and mode 0600, and validate it with scripts/production/preflight.sh.
CAMSTATION_ADDR=127.0.0.1:18080
CAMSTATION_DB=/var/lib/camstation2/data/camstation.db
CAMSTATION_RECORDINGS_DIR=/mnt/hdd/camstation2/recordings
CAMSTATION_TEMP_DIR=/mnt/hdd/camstation2/temp
CAMSTATION_VIEWER_RELEASES_DIR=/var/lib/camstation2/viewer-releases
CAMSTATION_RECORDING_ENABLED=true
CAMSTATION_SEGMENT_MINUTES=30
CAMSTATION_MAX_STORAGE_GB=700
