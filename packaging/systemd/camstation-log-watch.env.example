# Copy to /etc/camstation/camstation-log-watch.env with root:root 0600.
CAMSTATION_WATCH_API_BASE=http://10.0.0.26:18080
CAMSTATION_WATCH_CONTAINER=camstation2
CAMSTATION_WATCH_DOCKER_BIN=/usr/bin/docker
CAMSTATION_WATCH_DB_PATH=/var/lib/camstation2-production/data/camstation.db
CAMSTATION_WATCH_DAEMON_LOG=/var/lib/camstation2-production/data/logs/camstationd.jsonl
CAMSTATION_WATCH_OUTPUT_LOG=/var/lib/camstation2-production/data/logs/operational-watch.jsonl
CAMSTATION_WATCH_STATE_PATH=/var/lib/camstation2-production
CAMSTATION_WATCH_MEDIA_PATH=/mnt/hdd/camstation2-production
CAMSTATION_WATCH_LOCK_PATH=/run/lock/camstation-log-watch.lock
CAMSTATION_WATCH_TIMEOUT_SECONDS=5
CAMSTATION_WATCH_LOG_WINDOW_SECONDS=300
CAMSTATION_WATCH_LOGGER_STALE_SECONDS=180
CAMSTATION_WATCH_VIEWER_HEARTBEAT_STALE_SECONDS=30
CAMSTATION_WATCH_VIEWER_PROGRESS_STALE_SECONDS=90
CAMSTATION_WATCH_RECORDER_SEGMENT_GRACE_SECONDS=300
CAMSTATION_WATCH_WARN_BURST=10
CAMSTATION_WATCH_DISK_WARN_PERCENT=90
CAMSTATION_WATCH_DISK_ERROR_PERCENT=95
CAMSTATION_WATCH_STATE_MIN_FREE_BYTES=2147483648
CAMSTATION_WATCH_MEDIA_MIN_FREE_BYTES=21474836480
CAMSTATION_WATCH_OUTPUT_MAX_MB=10
CAMSTATION_WATCH_OUTPUT_FILES=4
