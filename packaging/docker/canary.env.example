# Copy to a root-owned deployment file outside the repository.
CAMSTATION_IMAGE=camstation:2.0.0-rc.20260812.12-canary
CANARY_BIND_IP=10.0.0.26
CANARY_MONITOR_BIND_IP=192.168.0.160
CANARY_HTTP_PORT=18081
CANARY_WEBRTC_PORT=18555
CAMSTATION_LOG_LEVEL=info
# Initial 2.0 soak: lower this to an empty value after the observation period.
CAMSTATION_LOG_LEVELS=playback=debug,stream.go2rtc=debug,stream.live_warm=debug,recorder.ffmpeg=debug
CAMSTATION_LOG_MAX_MB=64
CAMSTATION_LOG_FILES=32
CANARY_STATE_DIR=/var/lib/camstation2-canary/data
CANARY_MEDIA_DIR=/mnt/hdd/camstation2-canary
