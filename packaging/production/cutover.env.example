# Installation template only. This file is sourced by root-only cutover helpers.
# Copy it outside Git, replace every CHANGE_ME value, set owner root:root and mode 0600.
SERVICE_USER=camstation
SERVICE_GROUP=camstation
WORKING_DIR=/var/lib/camstation2
MEDIA_ROOT=/mnt/hdd/camstation2
DAEMON_ENV_FILE=/etc/camstation2/camstationd.env
V2_UNIT_FILE=/etc/systemd/system/camstationd-2x.service

RELEASES_ROOT=/opt/camstation2/releases
RELEASE_ID=CHANGE_ME
RELEASE_REAL_DIR=/opt/camstation2/releases/CHANGE_ME
RELEASE_DIR=/opt/camstation2/current
CAMSTATIOND_BIN=/opt/camstation2/current/bin/camstationd
MIGRATOR_BIN=/opt/camstation2/current/bin/camstation-migrate
CAMSTATIOND_SHA256=CHANGE_ME
MIGRATOR_SHA256=CHANGE_ME

LEGACY_DB=/var/lib/camstation-legacy/CHANGE_ME.db
SOURCE_SNAPSHOT=/var/lib/camstation-cutover/CHANGE_ME-legacy-snapshot.db
TARGET_DB=/var/lib/camstation2/data/camstation.db
STATE_DIR=/var/lib/camstation2/data
RECORDINGS_DIR=/mnt/hdd/camstation2/recordings
TEMP_DIR=/mnt/hdd/camstation2/temp
VIEWER_RELEASES_DIR=/var/lib/camstation2/viewer-releases
MIN_STATE_FREE_BYTES=5368709120
MIN_RECORDING_FREE_BYTES=107374182400

V2_UNIT=camstationd-2x.service
LEGACY_UNITS="camstation-backend.service camstation-backup.service go2rtc.service"
NGINX_UNIT=nginx.service
NGINX_ACTIVE_INCLUDE=/etc/nginx/camstation/active-backend.inc
NGINX_LEGACY_INCLUDE=/etc/nginx/camstation/legacy-location.inc
NGINX_V2_INCLUDE=/etc/nginx/camstation/camstation2-location.inc
NGINX_MAINTENANCE_INCLUDE=/etc/nginx/camstation/maintenance-location.inc
NGINX_SITE_FILE=/etc/nginx/sites-available/camstation
NGINX_SITE_LINK=/etc/nginx/sites-enabled/camstation
NGINX_DUPLICATE_SITE=/etc/nginx/sites-enabled/camstation.bak-20260630110552
NGINX_BACKUP_DIR=/etc/nginx/camstation-backups
LEGACY_NGINX_SITE_SHA256=CHANGE_ME

INTERNAL_BASE_URL=http://127.0.0.1:18080
PUBLIC_BASE_URL=http://192.168.0.160
EXPECTED_CAMERAS=9
EXPECTED_ENABLED=8
EXPECTED_SUBSTREAMS=9
EXPECTED_DISABLED_CAMERA=소방서2
EXPECTED_LAYOUTS=1
EXPECTED_LAYOUT_ITEMS=8
EXPECTED_SEGMENT_MINUTES=30
EXPECTED_RETENTION_DAYS=30
EXPECTED_MAX_STORAGE_GB=700

# Change to YES only in the approved maintenance window after the signed checklist is complete.
CUTOVER_APPROVED=NO
